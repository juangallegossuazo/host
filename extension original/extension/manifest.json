{
   "action": {
      "default_icon": {
         "128": "icons/icon128_active.png",
         "16": "icons/icon16_active.png",
         "32": "icons/icon32_active.png",
         "48": "icons/icon48_active.png"
      },
      "default_popup": "popup/popup.html"
   },
   "author": "ingenieroseninformatica.cl",
   "background": {
      "service_worker": "background/service-worker.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content/youtube-shorts.js" ],
      "matches": [ "*://*.youtube.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'"
   },
   "default_locale": "en",
   "description": "__MSG_shortDesc__",
   "host_permissions": [
      "https://raw.githubusercontent.com/*",
      "https://github.com/*",
      "<all_urls>"
   ],
   "icons": {
      "128": "icons/icon128_active.png",
      "16": "icons/icon16_active.png",
      "48": "icons/icon48_active.png"
   },
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "options_page": "options/options.html",
   "permissions": [ "storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "tabs", "activeTab", "webNavigation" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.3",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "blocked/blocked.html" ]
   } ]
}
